# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# University / Campus name for custom branding and matching prompts
UNIVERSITY_NAME=

# Database URL (PostgreSQL connection string from Aiven.io, Neon, or Supabase; if left empty, local SQLite campus_bot.db is used automatically)
# Example Aiven URI: postgres://avnadmin:your_password@pg-service-name.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=

# Admin Telegram User ID for alerts & management (optional)
ADMIN_USER_ID=
